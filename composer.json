{
    "name": "integrat/amocrm",
    "description": "Модуль для работы с amoCRM API v4 по долгосрочному токену",
    "license": "proprietary",
    "require": {
        "php": "^7.4 || ^8.0",
        "guzzlehttp/guzzle": "^7.9"
    },
    "autoload": {
        "psr-4": {
            "Amocrm\\": ""
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        }
    },
    "scripts": {
        "cs-check": "php-cs-fixer fix --dry-run --diff --rules=@PSR12 --using-cache=no .",
        "cs-fix": "php-cs-fixer fix --rules=@PSR12 --using-cache=no .",
        "test": "phpunit"
    }
}
